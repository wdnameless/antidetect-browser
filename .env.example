# Antidetect Browser — environment example (copy to .env for local dev).
# NEVER commit a real .env or production secrets.

# ---------------------------------------------------------------------------
# License key generation (vendor / developer tooling)
# ---------------------------------------------------------------------------
# Ed25519 private key (PKCS8 PEM) used ONLY by the vendor to sign license keys.
# Generate a keypair:
#   node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('ed25519');\
#   console.log(publicKey.export({type:'spki',format:'pem'}));\
#   console.log(privateKey.export({type:'pkcs8',format:'pem'}))"
# The matching PUBLIC key is pinned in src/main/licensing/publicKey.ts.
# LICENSE_PRIVATE_KEY is never read by the app itself — it is used by dev
# scripts to issue keys:
# LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ---------------------------------------------------------------------------
# Sync server (server/ package, optional self-host)
# ---------------------------------------------------------------------------
# HTTP port for the standalone teams sync server.
# SYNC_SERVER_PORT=8787
# Directory where the server stores its SQLite file.
# SYNC_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Local service (usually not needed — defaults are fine)
# ---------------------------------------------------------------------------
# API_HOST=127.0.0.1
# API_PORT=50325
# ANTIDETECT_DATA_DIR=
# ANTIDETECT_SETTINGS_DIR=
# ANTIDETECT_SERVER_MODE=0
# ANTIDETECT_TRUSTED_HOSTS=