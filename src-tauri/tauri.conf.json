{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NullTrace",
  "version": "0.6.24",
  "identifier": "com.antidetect.browser",
  "build": {
    "frontendDist": "http://127.0.0.1:50325"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline' http://127.0.0.1:* http://localhost:*; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https:; img-src 'self' data: blob: http://127.0.0.1:* http://localhost:* https:; font-src 'self' data: http://127.0.0.1:* http://localhost:* https:;"
    },
    "windows": []
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/wdnameless/antidetect-browser/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5RjQyM0Y4RUZBNEREN0YKUldSLzNhVHYrQ1AwS1QvcTBvajBEVFNDQU1jK2lBOXJkdCtDSDJCMktwdFR0Z2pSQ2ExaEw1QjkK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist": "dist",
      "../mcp/dist": "mcp/dist",
      "../resources/release-keyring.json": "resources/release-keyring.json"
    },
    "externalBin": [
      "binaries/node"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.13"
    }
  }
}
